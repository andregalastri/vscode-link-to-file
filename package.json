{
  "name": "galastri-link-to-file",
  "displayName": "Galastri Link to File",
  "description": "Open files in project directory using LINK: comments",
  "version": "1.0.2",
  "publisher": "andregalastri",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/andregalastri/vscode-link-to-file"
  },
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:python",
    "onLanguage:markdown",
    "onLanguage:html",
    "onLanguage:css",
    "onLanguage:plaintext",
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "galastri-link-to-file.openFile",
        "title": "Open Linked File"
      }
    ],
    "configuration": {
      "title": "Galastri Link to File",
      "properties": {
        "galastri-link-to-file.linkColor": {
          "type": "string",
          "format": "color",
          "default": "#000000",
          "description": "Color of the link text"
        },
        "galastri-link-to-file.linkBackgroundColor": {
          "type": "string",
          "format": "color",
          "default": "#ffffff",
          "description": "Background color of the link"
        },
        "galastri-link-to-file.showOpenFile": {
          "type": "boolean",
          "default": true,
          "description": "Show 'Open File' above the link"
        },
        "galastri-link-to-file.allowClickToFollowLink": {
          "type": "boolean",
          "default": true,
          "description": "Allow clicking to follow the link",
          "markdownDescription": "Allow clicking to follow the link using VS Code's native modifier (Ctrl+click or Alt+click, according to `editor.multiCursorModifier`)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "package": "webpack --mode production --devtool hidden-source-map",
    "webpack": "webpack --mode development",
    "webpack-watch": "webpack --mode development --watch",
    "test:windows": "node test/run.cjs",
    "package:vsix": "npx --yes @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^16.x",
    "@types/vscode": "^1.75.0",
    "@typescript-eslint/eslint-plugin": "^5.x",
    "@typescript-eslint/parser": "^5.x",
    "eslint": "^8.x",
    "ts-loader": "^9.x",
    "typescript": "^4.x",
    "webpack": "^5.x",
    "webpack-cli": "^5.x"
  },
  "license": "MIT"
}
